# Watches the workspace binaries the dev daemon runs (both profiles: the
# daemon and both GUIs, either of which config `gui_binary` may name as the
# overlay). Cargo replaces a binary by unlink + hardlink, which PathChanged
# sees as delete + create in the parent directory; wowdps-dev-reload then
# waits for the writes to settle and restarts wowdps-dev.service only when
# the ACTIVE profile's stamp changed — the daemon and the CONFIGURED GUI, so
# a build of the other GUI fires a reload that restarts nothing. A
# `gui_binary` path outside target/ is stamped but not watched: restart the
# unit after rebuilding it.
[Unit]
Description=Restart the wowdps dev daemon when its binaries are rebuilt

[Path]
PathChanged=@ROOT@/target/release/wowdps
PathChanged=@ROOT@/target/release/wowdps-gui
PathChanged=@ROOT@/target/release/wowdps-gui-new
PathChanged=@ROOT@/target/debug/wowdps
PathChanged=@ROOT@/target/debug/wowdps-gui
PathChanged=@ROOT@/target/debug/wowdps-gui-new
Unit=wowdps-dev-reload.service

[Install]
WantedBy=default.target
